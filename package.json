{
  "name": "spx-tracker",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "sync": "node scripts/sync.mjs",
    "sync:check": "node scripts/sync.mjs --check",
    "bump": "node scripts/sync.mjs --bump",
    "check": "npm run sync:check && npm run typecheck && npm test",
    "serve": "node scripts/serve.mjs",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium webkit",
    "ocr:fixture": "node scripts/ocr-fixture.mjs"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@playwright/test": "^1.56.0",
    "typescript": "^6.0.3"
  },
  "version": "1.0.0",
  "description": "PWA theo dõi điểm / thu nhập tài xế SPX: nhập tay hoặc quét ảnh (OCR), lưu cục bộ, sao lưu file / GitHub Gist, chạy offline.",
  "main": "sw.js",
  "directories": {
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linhshope124-a11y/Spx-Tracker.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/linhshope124-a11y/Spx-Tracker/issues"
  },
  "homepage": "https://github.com/linhshope124-a11y/Spx-Tracker#readme",
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0"
  }
}
